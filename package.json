{
  "name": "julie-ai-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JULIE AI OS — single-process command center (Express API + static web build)",
  "scripts": {
    "build": "tsc -p server/tsconfig.json",
    "web:build": "npm --prefix web run build",
    "dev": "tsx server/src/index.ts",
    "start": "node server/dist/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "express": "^4.21.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.23",
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
