# JULIE AI OS configuration template.
#
# Copy to `.env` and fill in the three required secrets:
#     cp .env.example .env && chmod 600 .env
#
# `.env` is gitignored and must stay mode 0600. Values may be unquoted or quoted;
# do not put trailing comments after a value (the whole remainder is the value).

# ---- required -------------------------------------------------------------
# Owner login password. Minimum 12 characters.
ADMIN_PASSWORD=

# Session-cookie secret. Minimum 24 characters. Generate one with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# OpenClaw Gateway shared secret. Find it in the OpenClaw configuration or with
# the OpenClaw CLI; never commit it to this repository.
GATEWAY_TOKEN=

# ---- network --------------------------------------------------------------
# Julie serves the API and the built web app on one port.
PORT=3000
BIND_HOST=0.0.0.0

# Real OpenClaw Gateway WebSocket endpoint.
GATEWAY_URL=ws://127.0.0.1:18789

# ---- storage (optional) ---------------------------------------------------
# Data directory (database, device identity, backups, generated assets).
# Relative values are resolved from the repository root. Default: data
# JULIE_DATA_DIR=data

# Database file, resolved inside the data directory unless absolute.
# Default: julie.db
# DB_PATH=julie.db

# ---- owner terminal (optional, high risk) ---------------------------------
# Disabled by default. When enabled, commands are owner-authenticated,
# rate-limited, secret-blocked, and confined to JULIE_TERMINAL_ROOT.
# JULIE_TERMINAL_ENABLED=false
# JULIE_TERMINAL_ROOT=.

# ---- tooling (optional) ---------------------------------------------------
# OpenClaw CLI used by `npm run doctor` for setup discovery.
# OPENCLAW_BIN=openclaw
